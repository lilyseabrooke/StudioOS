NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
ALLOWED_EMAIL_DOMAINS=studionorth.example
